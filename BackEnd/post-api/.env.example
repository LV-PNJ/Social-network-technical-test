# Copy to .env for local (non-Docker) runs. Do not commit .env.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=change-me
DB_NAME=devexp

APP_NAME=posts-service
JWT_ISSUER=identity-service
# Optional: inline PEM public key. Prefer file mount / JWT_PUBLIC_KEY_PATH.
# JWT_PUBLIC_KEY=
# JWT_PUBLIC_KEY_PATH=../certs/public.key

IDENTITY_URL=http://localhost:8081
MQTT_URL=mqtt://localhost:1883
MQTT_LIKES_TOPIC=devexp/posts/likes
