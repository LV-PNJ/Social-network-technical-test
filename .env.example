# Copy to .env and adjust. Do not commit real secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devexp

# JWT RS256 — private key only on Identity; public key shared with Posts API
# Default: classpath/baked keys for demo. Override with file mounts via compose ./certs
JWT_PRIVATE_KEY_LOCATION=classpath:certs/private.key
JWT_PUBLIC_KEY_LOCATION=classpath:certs/public.key
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=identity-service

CORS_ORIGINS=*
