# Copy to .env and adjust. Do not commit real secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devexp

# JWT RS256 — generate with: powershell -File scripts/generate-jwt-keys.ps1
# Private key only on Identity; public key shared with Posts (mounted from ./certs)
JWT_PRIVATE_KEY_LOCATION=file:/app/certs/private.key
JWT_PUBLIC_KEY_LOCATION=file:/app/certs/public.key
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=identity-service

# Logging
LOG_COLORS=true
LOG_TO_FILE=true
SPRING_OUTPUT_ANSI_ENABLED=ALWAYS

# MQTT
MQTT_URL=mqtt://mqtt:1883
MQTT_LIKES_TOPIC=devexp/posts/likes

CORS_ORIGINS=*
